# Copy to .env before running `docker compose up`. Both have working
# defaults in docker-compose.yml if you skip this — this is only for when
# you want to override them.

# Required for docker compose. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected by auth.py on purpose.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Sets (or resets) the `admin` password, min 8 chars. If unset, a
# random one is generated on first run and printed to the console/logs.
ADMIN_PASSWORD=

# Only needed if you deliberately want a different tag than qwen3:1.7b for
# everything — see llm.py's TASK_MODELS for per-task routing instead of a
# blanket override here.
OLLAMA_MODEL=qwen3:1.7b
